{
  "name": "graph-engine-workspace",
  "version": "2.0.0",
  "private": true,
  "description": "Workspace for the graph-engine TypeScript packages.",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx packages/graph-engine/index.ts",
    "clean": "rm -rf dist packages/graph-engine/dist",
    "build": "npm run clean && tsc -p packages/graph-engine/tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "start": "node packages/graph-engine/dist/graph-engine/index.js",
    "test:queue": "tsx packages/data-structures/test/queue.test.ts",
    "test:graph": "tsx packages/graph/test/directed-graph.test.ts && tsx packages/graph/test/strongly-connected-components.test.ts",
    "test:algorithms": "tsx packages/graph/test/algorithms.test.ts",
    "test:public": "tsx test/public-api.test.ts",
    "test:reactive": "tsx packages/reactive/test/computed.test.ts",
    "test:dynamic": "tsx packages/reactive/test/dynamic.test.ts",
    "test:scheduler": "tsx packages/reactive/test/scheduler.test.ts",
    "test:runtime": "tsx packages/reactive/test/runtime.test.ts",
    "test:effect": "tsx packages/reactive/test/effect.test.ts",
    "test:errors": "tsx packages/reactive/test/error-contracts.test.ts",
    "test:integration": "tsx packages/reactive/test/integration.test.ts",
    "test:phase0": "tsx test/phase0.test.ts",
    "test:unit": "node --import tsx --test --test-concurrency=1 packages/data-structures/test/*.test.ts packages/graph/test/*.test.ts packages/reactive/test/*.test.ts test/*.test.ts",
    "test:coverage": "node --import tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='packages/**/*.ts' --test-coverage-exclude='packages/**/test/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 packages/data-structures/test/*.test.ts packages/graph/test/*.test.ts packages/reactive/test/*.test.ts test/*.test.ts",
    "test": "npm run test:unit",
    "bench": "tsx benchmarks/run.ts",
    "bench:regression": "tsx benchmarks/regression.ts",
    "lint": "oxlint --deny-warnings .",
    "package:smoke": "node scripts/smoke-package.mjs",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run bench:regression && npm run build && npm run package:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run ci && changeset publish"
  },
  "license": "ISC",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.5.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
