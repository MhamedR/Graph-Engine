{
  "name": "graphora-workspace",
  "version": "2.0.0",
  "private": true,
  "description": "Workspace for the graphora TypeScript packages.",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx packages/graphora/index.ts",
    "clean": "rm -rf dist packages/graphora/dist",
    "build": "npm run clean && tsc -p packages/graphora/tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "start": "node packages/graphora/dist/graphora/index.js",
    "test:queue": "tsx packages/data-structures/test/queue.test.ts",
    "test:graph": "tsx packages/graph/test/directed-graph.test.ts && tsx packages/graph/test/strongly-connected-components.test.ts",
    "test:algorithms": "tsx packages/graph/test/algorithms.test.ts",
    "test:public": "tsx test/public-api.test.ts",
    "test:reactive": "tsx packages/reactive/test/computed.test.ts",
    "test:dynamic": "tsx packages/reactive/test/dynamic.test.ts",
    "test:scheduler": "tsx packages/reactive/test/scheduler.test.ts",
    "test:runtime": "tsx packages/reactive/test/runtime.test.ts",
    "test:effect": "tsx packages/reactive/test/effect.test.ts",
    "test:errors": "tsx packages/reactive/test/error-contracts.test.ts",
    "test:integration": "tsx packages/reactive/test/integration.test.ts",
    "test:phase0": "tsx test/phase0.test.ts",
    "test:unit": "node --import tsx --test --test-concurrency=1 packages/data-structures/test/*.test.ts packages/graph/test/*.test.ts packages/reactive/test/*.test.ts packages/integrations/test/*.test.ts test/*.test.ts",
    "test:coverage": "node --import tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='packages/**/*.ts' --test-coverage-exclude='packages/**/test/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 packages/data-structures/test/*.test.ts packages/graph/test/*.test.ts packages/reactive/test/*.test.ts packages/integrations/test/*.test.ts test/*.test.ts",
    "test": "npm run test:unit",
    "bench": "tsx benchmarks/run.ts",
    "bench:regression": "tsx benchmarks/regression.ts",
    "lint": "oxlint --deny-warnings .",
    "package:smoke": "node scripts/smoke-package.mjs",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run bench:regression && npm run build && npm run package:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run ci && changeset publish"
  },
  "license": "ISC",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^26.6.2",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
