{
  "name": "graph-engine",
  "version": "2.0.0",
  "description": "Framework-agnostic directed graph and reactive engine for TypeScript.",
  "type": "module",
  "main": "./dist/graph-engine/index.js",
  "types": "./dist/graph-engine/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/graph-engine/index.d.ts",
      "import": "./dist/graph-engine/index.js",
      "default": "./dist/graph-engine/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js",
      "default": "./dist/graph/index.js"
    },
    "./reactive": {
      "types": "./dist/reactive/index.d.ts",
      "import": "./dist/reactive/index.js",
      "default": "./dist/reactive/index.js"
    },
    "./advanced": {
      "types": "./dist/graph-engine/advanced.d.ts",
      "import": "./dist/graph-engine/advanced.js",
      "default": "./dist/graph-engine/advanced.js"
    },
    "./opentelemetry": {
      "types": "./dist/graph-engine/opentelemetry.d.ts",
      "import": "./dist/graph-engine/opentelemetry.js",
      "default": "./dist/graph-engine/opentelemetry.js"
    },
    "./inspector": {
      "types": "./dist/graph-engine/inspector.d.ts",
      "import": "./dist/graph-engine/inspector.js",
      "default": "./dist/graph-engine/inspector.js"
    },
    "./devtools": {
      "types": "./dist/graph-engine/devtools.d.ts",
      "import": "./dist/graph-engine/devtools.js",
      "default": "./dist/graph-engine/devtools.js"
    },
    "./store": {
      "types": "./dist/graph-engine/store.d.ts",
      "import": "./dist/graph-engine/store.js",
      "default": "./dist/graph-engine/store.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "npm --prefix ../.. run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MhamedR/Graph-Engine.git",
    "directory": "packages/graph-engine"
  },
  "keywords": [
    "directed-graph",
    "reactivity",
    "signals",
    "dependency-graph",
    "typescript"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MhamedR/Graph-Engine/issues"
  },
  "homepage": "https://github.com/MhamedR/Graph-Engine#readme"
}
